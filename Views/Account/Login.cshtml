@{ Layout = "_Layout"; }

<div class="auth-box">
    <h2>AgroSphere Login</h2>
    @if (ViewBag.Error != null) { <div class="error-msg">@ViewBag.Error</div> }
    <form method="post" action="/Account/Login" id="loginForm">
        <input type="text" id="username" name="username" placeholder="Username" required />
        <input type="password" id="password" name="password" placeholder="Password" required />
        <button type="submit">Sign In</button>
    </form>
    <div style="margin-top:16px;padding:12px;background:#f0f7f2;border:1px solid #d0e7d5;border-radius:6px;font-size:12px;">
        <div style="font-weight:600;color:#2d5a3d;margin-bottom:6px;">Demo Accounts:</div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
            <span><strong>samarth</strong> / pass123 (Admin)</span>
            <button type="button" onclick="fillLogin('samarth','pass123')" style="width:auto;padding:3px 8px;font-size:11px;background:#2d5a3d;color:#fff;border:none;border-radius:3px;cursor:pointer;">Use</button>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;">
            <span><strong>panth</strong> / pass123 (Farmer)</span>
            <button type="button" onclick="fillLogin('panth','pass123')" style="width:auto;padding:3px 8px;font-size:11px;background:#2d5a3d;color:#fff;border:none;border-radius:3px;cursor:pointer;">Use</button>
        </div>
    </div>
    <div class="link">No account? <a href="/Account/Register">Register</a></div>
</div>

<script>
function fillLogin(u, p) {
    document.getElementById('username').value = u;
    document.getElementById('password').value = p;
    document.getElementById('loginForm').submit();
}
</script>
